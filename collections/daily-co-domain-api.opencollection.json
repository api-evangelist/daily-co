{
  "opencollection": "1.0.0",
  "info": {
    "name": "Daily REST CallTransfer Domain API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Domain",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get domain configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.daily.co/v1/"
          },
          "docs": "Get domain configuration"
        },
        {
          "info": {
            "name": "Set domain configuration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.daily.co/v1/",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Set domain configuration"
        }
      ]
    }
  ],
  "bundled": true
}