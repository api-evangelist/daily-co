{
  "opencollection": "1.0.0",
  "info": {
    "name": "Daily REST CallTransfer DialOut API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "DialOut",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Start dial-out call",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.daily.co/v1/rooms/:name/dialOut/start",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Start dial-out call"
        },
        {
          "info": {
            "name": "Send DTMF tones",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.daily.co/v1/rooms/:name/dialOut/sendDTMF",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Send DTMF tones"
        },
        {
          "info": {
            "name": "Stop dial-out call",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.daily.co/v1/rooms/:name/dialOut/stop",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Stop dial-out call"
        }
      ]
    }
  ],
  "bundled": true
}